# Copy to .env (git-ignored) and fill in locally. Never commit real keys.
# Run: uvicorn app.main:app --host 127.0.0.1 --env-file .env
# Every provider configured here appears in the UI's Model dropdown; LLM_PROVIDER is the default.
# LLM_PROVIDER: mock | claude | ollama | ollama-remote | gemini
LLM_PROVIDER=mock

# Claude (enabled only when the key is set)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Ollama on this machine (enabled only when OLLAMA_URL is set, e.g. http://localhost:11434)
OLLAMA_URL=
OLLAMA_MODEL=

# Optional second Ollama host reached through an SSH tunnel, e.g.
#   ssh -N -L 11435:localhost:11434 <user>@<remote-host>
# OLLAMA_REMOTE_URL=http://localhost:11435
# OLLAMA_REMOTE_MODEL=
# OLLAMA_REMOTE_TIMEOUT=90
# OLLAMA_REMOTE_NUM_PREDICT=200
